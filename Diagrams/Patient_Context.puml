@startuml

title Patient Context

skinparam class {
  BackgroundColor<<Aggregate Root>> #FFE0B2
  BorderColor<<Aggregate Root>> #E65100

  BackgroundColor<<Entity>> #C8E6C9
  BorderColor<<Entity>> #2E7D32

  BackgroundColor<<Value Object>> #B3E5FC
  BorderColor<<Value Object>> #01579B
}

class Patient <<Aggregate Root>> {
    - patientId : PatientId
    - firstName : FirstName
    - lastName : LastName
    - phoneNumber : PhoneNumber
    ---
    +requestAppointment(doctorId : DoctorId, date : Date) : Appointment
}



class FirstName <<Value Object>> {
    - value : String
}

class LastName <<Value Object>> {
    - value : String
}

class PhoneNumber <<Value Object>> {
    - value : String
}


Patient *-- FirstName
Patient *-- LastName
Patient *-- PhoneNumber

legend right
  |= Color |= Element |
  |<#FFE0B2> | **Aggregate Root** |
  |<#C8E6C9> | **Entity** |
  |<#B3E5FC> | **Value Object** |
  |<#F5F5F5> | **Enumeration** |
  --
  <color:#E65100>Aggregate Root:</color>
  The entry point to an aggregate and the only
  object referenced from outside the aggregate.
  --
  <color:#01579B>Value Object:</color>
  An immutable object defined by its values,
  without an independent identity.
end legend

@enduml